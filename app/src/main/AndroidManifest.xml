<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Реально используемые приложением разрешения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Переставить будильник проверки курса после перезагрузки/обновления
         (BootReceiver). Раньше подмешивался транзитивно WorkManager'ом; теперь
         у нас свой boot-receiver, поэтому объявляем явно. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- WorkManager подмешивает разрешение foreground-сервиса, но мы используем
         только отложенную периодическую задачу (без foreground service) —
         убираем, чтобы не заявлять лишнего (важно для проверки Google Play).
         WAKE_LOCK / ACCESS_NETWORK_STATE / RECEIVE_BOOT_COMPLETED (тоже от
         WorkManager) — обычные install-time разрешения, нужны для надёжной
         работы ежедневного уведомления, поэтому остаются. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />

    <application
        android:name=".CurrencyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CurrencyConverter">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.CurrencyConverter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Срабатывание будильника проверки курса (AlarmScheduler).
             exported=false — будим только своим PendingIntent. -->
        <receiver
            android:name=".work.RateAlarmReceiver"
            android:exported="false" />

        <!-- Переставить будильник после перезагрузки устройства и после
             обновления приложения. exported=true — события шлёт система. -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
